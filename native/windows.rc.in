// The Windows program's resources (native/CMakeLists.txt): its icon (native/icon/AppIcon.ico) and its version
@TWIN_RC_ICON@
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GioPixelGH"
            VALUE "FileDescription", "Crash Twinsanity"
            VALUE "LegalCopyright", "Windows port by GioPixelGH. Based on Smartkin's decompilation and HAB3X's Mac port. Crash Twinsanity \251 Activision."
            VALUE "ProductName", "Crash Twinsanity (native port of the PS2 decompilation)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "CrashTwinsanity.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
